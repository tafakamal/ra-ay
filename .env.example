# ============================================================
# Konfigurasi Environment RA Attakal Yaqiin
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# Aplikasi
APP_URL=http://localhost/RAAY
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ra_attakal_yaqiin
DB_USERNAME=root
DB_PASSWORD=

# Nama Situs
SITE_NAME="RA Attakal Yaqiin"
